{
  "openapi": "3.0.3",
  "info": {
    "title": "ShopStream API",
    "description": "Event-driven e-commerce microservices backend. All traffic goes through the API gateway.\n\n**Authentication:** obtain a JWT from `POST /api/v1/auth/login`, then click **Authorize** (lock icon) and paste it as `Bearer <token>`. Protected operations show `401` without a valid token and `403` when the token is valid but not allowed (e.g. reading another user's data).\n\n**Public (no token):** health checks, product catalog reads, stock lookup, register/login.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "API gateway (Docker)"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Registration and login"
    },
    {
      "name": "Users",
      "description": "User profiles"
    },
    {
      "name": "Products",
      "description": "Product catalog (creates inventory automatically)"
    },
    {
      "name": "Orders",
      "description": "Order lifecycle with stock deduction + rollback"
    },
    {
      "name": "Inventory",
      "description": "Stock levels (atomic ACID deduction)"
    },
    {
      "name": "Health",
      "description": "Liveness checks"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Gateway health check",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "service": {
                      "type": "string",
                      "example": "api-gateway"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "getHealth"
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a new user",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "email": "john@test.com",
                "password": "pass123",
                "name": "John Doe"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created (password is hashed, never returned)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Email already registered"
                }
              }
            }
          }
        },
        "operationId": "registerUser"
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login and receive a JWT (24h expiry)",
        "description": "The returned `token` is what you pass to the **Authorize** button on this page.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "john@test.com",
                "password": "pass123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "operationId": "loginUser"
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get a user profile (owner or ADMIN only)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User profile (no password)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "getUserById",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "List all products (public)",
        "security": [],
        "responses": {
          "200": {
            "description": "Products, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductListResponse"
                }
              }
            }
          }
        },
        "operationId": "listProducts"
      },
      "post": {
        "tags": [
          "Products"
        ],
        "summary": "Create a product (auto-creates inventory with 0 stock)",
        "description": "The product is saved first, then inventory is synced through a circuit breaker — creation still succeeds if inventory-service is down (`inventorySync.synced = false`).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductCreateRequest"
              },
              "example": {
                "name": "iPhone 15 Pro",
                "description": "Latest Apple flagship",
                "price": 999.99,
                "category": "Electronics",
                "attributes": {
                  "color": "Titanium",
                  "storage": "256GB"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductCreateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "operationId": "createProduct",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/products/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Get a product by ID (public)",
        "security": [],
        "responses": {
          "200": {
            "description": "Product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "getProductById"
      },
      "put": {
        "tags": [
          "Products"
        ],
        "summary": "Update a product",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductUpdateRequest"
              },
              "example": {
                "price": 899.99
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "updateProduct",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Products"
        ],
        "summary": "Delete a product",
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Product deleted"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "deleteProduct",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "List all orders",
        "responses": {
          "200": {
            "description": "Orders, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "operationId": "listOrders",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Place an order (deducts stock, saga rollback on failure)",
        "description": "`userId` must match the authenticated user (403 otherwise). Stock is deducted atomically per item; if any item fails, already-deducted items are rolled back and the stock is restored.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCreateRequest"
              },
              "example": {
                "userId": "<your-user-id-from-login>",
                "items": [
                  {
                    "productId": "<product-id>",
                    "productName": "iPhone 15 Pro",
                    "quantity": 2,
                    "price": 999.99
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order confirmed, stock deducted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or insufficient stock",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "insufficient": {
                    "value": {
                      "error": "Order failed: Insufficient stock"
                    }
                  },
                  "validation": {
                    "value": {
                      "error": "items must be a non-empty array"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "description": "userId does not match the token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "userId does not match authenticated user"
                }
              }
            }
          }
        },
        "operationId": "createOrder",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/orders/user/{userId}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "List a user's orders (owner or ADMIN)",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User's orders",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "operationId": "listUserOrders",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Get an order by ID (owner or ADMIN)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "getOrderById",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/orders/{id}/status": {
      "put": {
        "tags": [
          "Orders"
        ],
        "summary": "Update order status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "PENDING",
                      "CONFIRMED",
                      "SHIPPED",
                      "DELIVERED",
                      "CANCELLED"
                    ]
                  }
                }
              },
              "example": {
                "status": "SHIPPED"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "updateOrderStatus",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/inventory": {
      "post": {
        "tags": [
          "Inventory"
        ],
        "summary": "Create inventory record (idempotent, called by product-service)",
        "description": "Duplicate calls return the existing record without resetting stock. Called internally with the creating user's forwarded JWT.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "productId"
                ],
                "properties": {
                  "productId": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "productId": "<product-id>"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already exists — returned as-is",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryResponse"
                }
              }
            }
          },
          "201": {
            "description": "Created with quantity 0",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "operationId": "createInventory",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/inventory/{productId}": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Get stock for a product (public)",
        "security": [],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current stock",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "getInventory"
      }
    },
    "/api/v1/inventory/{productId}/add": {
      "post": {
        "tags": [
          "Inventory"
        ],
        "summary": "Add stock (restock / rollback compensation)",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuantityRequest"
              },
              "example": {
                "quantity": 50
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated inventory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "addStock",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/inventory/{productId}/deduct": {
      "put": {
        "tags": [
          "Inventory"
        ],
        "summary": "Deduct stock atomically (prevents overselling)",
        "description": "Compiles to `UPDATE ... WHERE quantity >= n` in PostgreSQL — a single guarded statement with a row lock, safe under concurrent orders.",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuantityRequest"
              },
              "example": {
                "quantity": 2
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated inventory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Insufficient stock or invalid quantity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Insufficient stock"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "operationId": "deductStock",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Paste the `token` from `POST /api/v1/auth/login` (with or without the `Bearer ` prefix)."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid or expired JWT",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "missing": {
                "value": {
                  "error": "Authentication required"
                }
              },
              "invalid": {
                "value": {
                  "error": "Invalid or expired token"
                }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Valid token but not allowed (not the owner, not ADMIN)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Forbidden"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Not found"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Something went wrong"
          }
        },
        "required": [
          "error"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@test.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "example": "pass123"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "example": "John Doe"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@test.com"
          },
          "password": {
            "type": "string",
            "example": "pass123"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "example": "CUSTOMER"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT, valid 24h"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "6aca3e80f8f4546470163bd4"
          },
          "name": {
            "type": "string",
            "example": "iPhone 15 Pro"
          },
          "description": {
            "type": "string",
            "example": "Latest Apple flagship"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "example": 999.99
          },
          "category": {
            "type": "string",
            "example": "Electronics"
          },
          "imageUrl": {
            "type": "string"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "color": "Titanium",
              "storage": "256GB"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProductCreateRequest": {
        "type": "object",
        "required": [
          "name",
          "price"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "iPhone 15 Pro"
          },
          "description": {
            "type": "string",
            "example": "Latest Apple flagship"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "example": 999.99
          },
          "category": {
            "type": "string",
            "example": "Electronics"
          },
          "imageUrl": {
            "type": "string"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ProductResponse": {
        "type": "object",
        "properties": {
          "product": {
            "$ref": "#/components/schemas/Product"
          }
        }
      },
      "ProductListResponse": {
        "type": "object",
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          }
        }
      },
      "InventorySyncResult": {
        "type": "object",
        "properties": {
          "synced": {
            "type": "boolean",
            "description": "false when the circuit breaker is open (inventory-service unreachable)"
          },
          "message": {
            "type": "string",
            "example": "queued for retry"
          },
          "inventory": {
            "$ref": "#/components/schemas/Inventory"
          }
        }
      },
      "ProductCreateResponse": {
        "type": "object",
        "properties": {
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "inventorySync": {
            "$ref": "#/components/schemas/InventorySyncResult"
          }
        }
      },
      "Inventory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "example": 48
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "InventoryResponse": {
        "type": "object",
        "properties": {
          "inventory": {
            "$ref": "#/components/schemas/Inventory"
          }
        }
      },
      "QuantityRequest": {
        "type": "object",
        "required": [
          "quantity"
        ],
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "example": 50
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "required": [
          "productId",
          "productName",
          "quantity",
          "price"
        ],
        "properties": {
          "productId": {
            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "price": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "total": {
            "type": "number",
            "description": "Computed server-side from quantity × price",
            "example": 1999.98
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "SHIPPED",
              "DELIVERED",
              "CANCELLED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderCreateRequest": {
        "type": "object",
        "required": [
          "userId",
          "items"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "description": "Must equal the authenticated user's id",
            "example": "<your-user-id-from-login>"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          }
        }
      },
      "OrderResponse": {
        "type": "object",
        "properties": {
          "order": {
            "$ref": "#/components/schemas/Order"
          }
        }
      },
      "OrderListResponse": {
        "type": "object",
        "properties": {
          "orders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          }
        }
      },
      "ProductUpdateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "iPhone 15 Pro"
          },
          "description": {
            "type": "string",
            "example": "Latest Apple flagship"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "example": 999.99
          },
          "category": {
            "type": "string",
            "example": "Electronics"
          },
          "imageUrl": {
            "type": "string"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
