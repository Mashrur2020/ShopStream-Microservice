# ShopStream secrets template.
# Copy to .env and replace the placeholders:
#   cp .env.example .env
# .env is gitignored — never commit real values.

# PostgreSQL superuser used by user-service and inventory-service
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# Shared JWT secret for all services (must match across user/product/order/inventory).
# Generate a strong value with: openssl rand -hex 32
JWT_SECRET=change-me
